# Used for links in page metadata. Defaults to https://streamtoshelf.com
NEXT_PUBLIC_SITE_URL=https://streamtoshelf.com

# Discogs, for master pages and physical releases. Without it Discogs falls back to search links.
# Get a token from: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your_discogs_token

# Tavily, for direct links to stores with no API. Without it those stores use search links.
# Get a key from: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key
